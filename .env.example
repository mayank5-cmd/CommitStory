# Get a key at https://aistudio.google.com/app/apikey
# The app accepts EITHER variable (GEMINI_API_KEY takes precedence).
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# Optional — needed for private repos + higher rate limits (5000/hr vs 60/hr).
# Create at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Express server port
PORT=3000

# Diff limits for the web server (0 = unlimited). The server keeps high but
# bounded defaults since POST /api/analyze is public (abuse/bill guard).
# The CLI is unlimited by default — constrain it with
#   commitstory --compare main..feature --max-files 50 --max-chars 100000
MAX_DIFF_FILES=1000
MAX_DIFF_LINES_PER_FILE=2000
MAX_DIFF_CHARS=500000
